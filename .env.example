# Copy this file to .env only when rerunning the upstream Google Places and
# constrained-LLM collection workflow.  The canonical downstream rebuild under
# analysis/ uses frozen local inputs and does not call either service.
#
# Keep .env local.  Never add a real credential to a repository or transfer
# archive.

OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=

# A key or billing credit does not unlock the live v2 workflow. This file must point
# to a local written-permission record that covers every use checked by v2_workflow.
GOOGLE_PLACES_AUTHORIZATION_FILE=
NETS_AI_V2_MODEL=
