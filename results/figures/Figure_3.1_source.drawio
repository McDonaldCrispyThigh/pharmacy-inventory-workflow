<mxfile host="app.diagrams.net"><diagram name="Figure 3.1 Inventory construction" id="Figure_3.1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="c3" value="START" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1F4F78;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#1F4F78&quot;&gt;1&amp;nbsp;&amp;nbsp;Search Google Places&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;Search each of 60 target ZIP codes with three terms&lt;br&gt;(&amp;quot;pharmacy,&amp;quot; &amp;quot;drug store,&amp;quot; and &amp;quot;drugstore&amp;quot;).&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="600" height="104" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;&lt;font color=&quot;#1F4F78&quot;&gt;Finer-grid search&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;Google returns at most 60 results per search. Where a search hit this cap, the area was split into a finer grid and searched again.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="32" width="270" height="104" as="geometry"/></mxCell>
<mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#1F4F78&quot;&gt;2&amp;nbsp;&amp;nbsp;Merge results into unique places&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;Each Google listing has a unique Place ID. Results sharing a Place ID were merged, so each place appears once.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="600" height="104" as="geometry"/></mxCell>
<mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.22;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="845" y="199"/></Array></mxGeometry></mxCell>
<mxCell id="c10" value="&lt;b&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#1F4F78&quot;&gt;2,062 candidates&lt;/font&gt;&lt;/b&gt;&lt;br&gt;from all searches" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4F78;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="710" y="221" width="270" height="72" as="geometry"/></mxCell>
<mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#1F4F78&quot;&gt;3&amp;nbsp;&amp;nbsp;Build an evidence packet for each candidate&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;The packet was assembled and frozen before any judgment.&lt;br&gt;Missing evidence was recorded as missing.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="600" height="200" as="geometry"/></mxCell>
<mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value="&lt;b&gt;&lt;font color=&quot;#1F4F78&quot;&gt;Listing details&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;name, address, category, operating status&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=top;spacing=8;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="416" width="184" height="88" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;&lt;font color=&quot;#1F4F78&quot;&gt;User reviews&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;up to five, as returned by Google&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=top;spacing=8;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="248" y="416" width="184" height="88" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;&lt;font color=&quot;#1F4F78&quot;&gt;Archived website&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;a page counts as store evidence only if it shows the store&amp;#39;s address or phone&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=top;spacing=8;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="442" y="416" width="184" height="88" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#1F4F78&quot;&gt;4&amp;nbsp;&amp;nbsp;Language model judgments (gpt-5-mini)&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;The model read the packet and answered four yes-or-no questions (Table 3.1).&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="600" height="200" as="geometry"/></mxCell>
<mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c19" value="&lt;b&gt;Target pharmacy?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="646" width="135" height="56" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;Operating?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="197" y="646" width="135" height="56" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Plausible record?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="646" width="135" height="56" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;Same establishment?&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7FAACB;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=6;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="483" y="646" width="135" height="56" as="geometry"/></mxCell>
<mxCell id="c23" value="A Python script checked every response: required format, allowed labels, and evidence IDs drawn from the packet." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#55687A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="54" y="708" width="572" height="44" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#1F4F78&quot;&gt;5&amp;nbsp;&amp;nbsp;Apply the fixed inclusion rule&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;Include a candidate only if all four answers are yes.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FB;strokeColor=#7FAACB;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="600" height="80" as="geometry"/></mxCell>
<mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c26" value="&lt;b&gt;Workflow pharmacy inventory&lt;/b&gt;&lt;br&gt;592 included" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F4F78;strokeColor=#1F4F78;strokeWidth=2;align=center;verticalAlign=middle;spacing=12;fontSize=15;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="380" height="64" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;Excluded&lt;/b&gt;&lt;br&gt;1,470" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#A9B6C2;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=12;fontSize=15;fontColor=#22313F;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="916" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#1F4F78;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.31666666666666665;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=7;strokeWidth=2;strokeColor=#8796A5;fontSize=12;fontColor=#55687A;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c30" value="&lt;b&gt;&lt;font color=&quot;#1F4F78&quot;&gt;Kept for audit&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;Every packet and model response is saved, so each inclusion or exclusion can be traced to its evidence.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The Board list enters only at the evaluation stage (Figure 3.2).&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A9B6C2;strokeWidth=1.6;align=left;verticalAlign=top;spacing=12;fontSize=13;fontColor=#22313F;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="800" width="270" height="130" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>